# IMeC Analysis — variáveis de ambiente (Task 008)
# Copie para `.env` e preencha as chaves. O arquivo `.env` NÃO é versionado.

# Provedor ativo: openai | gemini
LLM_PROVIDER=openai

# Liga/desliga a camada LLM (fail-soft se false ou sem chave)
LLM_ENABLED=true

# Por default NÃO chama LLM para classes majoritárias (camada A)
LLM_SKIP_TIER_A=true

# Critérios adicionais de gate (úteis se LLM_SKIP_TIER_A=false)
LLM_MIN_PROBA=0.70
LLM_MIN_TOP_GAP=0.15

LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
