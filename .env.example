# IMeC Analysis — variáveis de ambiente (Task 008 + publicação experimental)
# Copie para `.env` e preencha as chaves. O arquivo `.env` NÃO é versionado.
#
# Local vs Cloud Run:
#   Local  → este `.env` (gitignored). A API lê OPENAI_API_KEY / GEMINI_API_KEY via os.getenv.
#   Cloud  → NÃO use `.env` nem `--set-env-vars` para chaves.
#            Grave a chave no Secret Manager e injete com `--set-secrets`
#            (ver docs/proposta_publicacao_experimental.md, seção 3.4).
# Nunca coloque a chave no Git, no Dockerfile, no chat ou em variável visível no console.

# --- API (local e PaaS) ---
# Cloud Run / Render / Koyeb injetam PORT; IMEC_API_PORT tem precedência.
# IMEC_API_PORT=8000
# IMEC_API_HOST=0.0.0.0
# IMEC_API_RELOAD=false
# IMEC_API_HTTPS=false

# Provedor ativo: openai | gemini
# No Cloud Run, envie o mesmo valor em --set-env-vars (não é segredo).
LLM_PROVIDER=openai

# Liga/desliga a camada LLM (fail-soft se false ou sem chave).
# Local: true se quiser testar revisão LLM.
# Cloud Run experimental: mantenha false até o secret existir; o Dockerfile já defaulta false.
LLM_ENABLED=true

# Por default NÃO chama LLM para classes majoritárias (camada A)
LLM_SKIP_TIER_A=true

# Critérios adicionais de gate (úteis se LLM_SKIP_TIER_A=false)
LLM_MIN_PROBA=0.70
LLM_MIN_TOP_GAP=0.15

LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Firestore + Autenticação JWT (Task 010) ---
# Ver docs/task010_firestore_auth_historico.md
FIRESTORE_ENABLED=true
FIRESTORE_PROJECT_ID=imec-analysis
FIRESTORE_DATABASE_ID=imec-analysis

# Segredo simétrico (HS256) — NUNCA no Git/Dockerfile/--set-env-vars.
# Local: gere com `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Cloud Run: Secret Manager + `--set-secrets` (mesmo padrão da chave LLM).
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
